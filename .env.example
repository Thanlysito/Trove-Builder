# Copia este archivo a ".env" (sin ".example") y pon tus valores reales ahí.
# El archivo ".env" NUNCA se sube a git — solo esta plantilla.

DJANGO_SECRET_KEY=genera-una-nueva-con-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicación-de-gmail

# --- Solo para cuando despliegues a producción (Railway/Render) ---
# En local, deja estas 3 en blanco o bórralas: el proyecto sigue usando
# db.sqlite3 y http://127.0.0.1:8000 sin ningún problema.

# Si usas Postgres en el servidor, Railway/Render la definen solas.
# DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd

# El dominio real que te den (sin "https://"), por ejemplo:
# DJANGO_ALLOWED_HOSTS=tu-proyecto.up.railway.app

# El mismo dominio pero con "https://" al inicio, por ejemplo:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-proyecto.up.railway.app
